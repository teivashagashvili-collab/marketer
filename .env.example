# Copy to .env (never commit it) or export these in your shell / hosting provider.
# Anything left blank simply disables that channel.

ANTHROPIC_API_KEY=
MEMEPROMO_MODEL=claude-opus-5-5

# Safety switches
MEMEPROMO_DRY_RUN=true            # true = generate and log posts, never send them
MEMEPROMO_DISCLAIMER=Not financial advice. DYOR.
MEMEPROMO_PAID_PROMO=false        # true adds "#ad" to every post (required if you are paid to promote)

# X (Twitter) - developer app with Read+Write, OAuth 1.0a user tokens for YOUR account
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Telegram - a bot that is admin of a channel/group YOU own
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                 # e.g. @mytokenchannel or -100123456789

# Discord - webhook URL for a channel in a server YOU admin
DISCORD_WEBHOOK_URL=

# Bluesky - your handle and an app password (Settings > App passwords)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Farcaster via Neynar - API key and a signer for YOUR account
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=
